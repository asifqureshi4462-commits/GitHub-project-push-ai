<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFileItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="3dp"
    app:cardCornerRadius="10dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_dark"
    app:cardBackgroundColor="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbFileSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/brand_primary"/>

        <ImageView
            android:id="@+id/ivFileType"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_code"
            app:tint="@color/brand_cyan"
            android:contentDescription="File icon"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="src/main/java/App.java"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="middle"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.2 KB"
                android:textColor="@color/text_tertiary_dark"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnFilePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview"
            android:textSize="11sp"
            android:textColor="@color/brand_accent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_glass_card"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
