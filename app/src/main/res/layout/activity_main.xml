<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_dark"
            app:titleTextColor="@color/text_primary_dark"
            app:title="@string/app_name"
            app:subtitle="@string/app_tagline"
            app:subtitleTextColor="@color/text_secondary_dark"
            app:navigationIcon="@drawable/ic_app_logo">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHeaderStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textColor="@color/status_warning"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_card"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Main Content Area: Frames for the 5 Tabs -->
        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/includeDashboard"
                layout="@layout/view_dashboard"
                android:visibility="visible"/>

            <include
                android:id="@+id/includeRepos"
                layout="@layout/view_repos"
                android:visibility="gone"/>

            <include
                android:id="@+id/includePusher"
                layout="@layout/view_pusher"
                android:visibility="gone"/>

            <include
                android:id="@+id/includeAiTools"
                layout="@layout/view_ai_tools"
                android:visibility="gone"/>

            <include
                android:id="@+id/includeSettingsHistory"
                layout="@layout/view_settings_history"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark"
            app:itemIconTint="@color/brand_primary"
            app:itemTextColor="@color/text_primary_dark"
            app:itemRippleColor="#336C5CE7"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"/>
    </LinearLayout>

    <!-- Fullscreen Splash & Onboarding Overlay -->
    <LinearLayout
        android:id="@+id/overlayOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_dark"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="Logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary_dark"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:textAlignment="center"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke_dark"
            app:cardBackgroundColor="@color/surface_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvOnboardingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_title_1"
                    android:textColor="@color/brand_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvOnboardingDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onboarding_desc_1"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnboardingAction"
            style="@style/Widget.GitForge.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_get_started"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnOnboardingSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_skip"
            android:textColor="@color/text_tertiary_dark"
            android:textSize="14sp"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Fullscreen GitHub Login Overlay -->
    <LinearLayout
        android:id="@+id/overlayLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_dark"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_github"
            app:tint="@color/brand_primary"
            android:contentDescription="GitHub"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_title"
            android:textColor="@color/text_primary_dark"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            android:textAlignment="center"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke_dark"
            app:cardBackgroundColor="@color/surface_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="GitHub Personal Access Token"
                    app:boxStrokeColor="@color/brand_primary"
                    app:hintTextColor="@color/brand_primary"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_pat_hint"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="14sp"
                        android:inputType="textPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/login_pat_helper"
                    android:textColor="@color/text_tertiary_dark"
                    android:textSize="11sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoginConnect"
                    style="@style/Widget.GitForge.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/login_btn_connect"
                    android:textSize="14sp"/>

                <!-- Device Code Display Box (when active) -->
                <LinearLayout
                    android:id="@+id/layoutDeviceCodeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_device_instructions"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        android:textAlignment="center"/>

                    <TextView
                        android:id="@+id/tvDeviceCodeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="XXXX-XXXX"
                        android:textColor="@color/brand_cyan"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenDeviceUrl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Verification Page"
                        android:textColor="@color/brand_accent"
                        android:textSize="12sp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoginDeviceFlow"
                    style="@style/Widget.GitForge.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/login_device_btn_start"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/status_error"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnLoginCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Dismiss"
            android:textColor="@color/text_tertiary_dark"
            android:textSize="14sp"
            android:padding="8dp"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
