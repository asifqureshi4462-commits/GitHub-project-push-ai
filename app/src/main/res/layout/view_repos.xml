<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutReposView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Search & Filter Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="14dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_dark"
        app:cardBackgroundColor="@color/surface_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary_dark"
                android:contentDescription="@string/repo_search_hint"/>

            <EditText
                android:id="@+id/etSearchRepos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/repo_search_hint"
                android:textColorHint="@color/text_tertiary_dark"
                android:textColor="@color/text_primary_dark"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <ProgressBar
                android:id="@+id/pbReposLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selected Repo & Branch Quick Status Banner (when selected) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedRepoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/brand_primary"
        app:cardBackgroundColor="@color/surface_variant_dark"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/status_success"
                android:contentDescription="Selected"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedRepoName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="owner/repo"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSelectedBranchName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: main"
                    android:textColor="@color/brand_accent"
                    android:textSize="11sp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeBranch"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branches"
                android:textColor="@color/brand_cyan"
                android:textSize="12sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Branch Selection Dialog/Sheet Overlay inside view -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBranchSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke_dark"
        app:cardBackgroundColor="@color/surface_dark"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvBranchSelectorTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/repo_branch_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnCloseBranchSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Done"
                    android:textColor="@color/brand_accent"
                    android:textStyle="bold"
                    android:padding="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBranches"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRepositories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/tvEmptyRepos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="No repositories found.\nConnect your GitHub account in Settings or check token permissions."
        android:textColor="@color/text_tertiary_dark"
        android:textSize="14sp"
        android:visibility="gone"/>

</LinearLayout>
